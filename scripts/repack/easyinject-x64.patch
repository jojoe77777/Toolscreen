diff --git a/exe/CMakeLists.txt b/exe/CMakeLists.txt
index f074a4b..c4e1cff 100644
--- a/exe/CMakeLists.txt
+++ b/exe/CMakeLists.txt
@@ -43,6 +43,15 @@ set(ARCHITECTURE_PAYLOAD_FILES
     "${CUSTOM_DLL_DIR}/Toolscreen_x64.dll"
     "${CUSTOM_DLL_DIR}/Toolscreen_arm64.dll"
 )
+option(EASYINJECT_X64_ONLY "Package only the x64 payload" OFF)
+if(EASYINJECT_X64_ONLY)
+    if(NOT CMAKE_SIZEOF_VOID_P EQUAL 8 OR CMAKE_GENERATOR_PLATFORM STREQUAL "ARM64")
+        message(FATAL_ERROR "X64-only packaging requires an x64 compiler")
+    endif()
+    list(FILTER LOGGER_DLL_FILES EXCLUDE REGEX "liblogger_arm64[.]dll$")
+    list(FILTER ARCHITECTURE_PAYLOAD_FILES EXCLUDE REGEX "Toolscreen_arm64[.]dll$")
+    list(FILTER CUSTOM_DLL_FILES EXCLUDE REGEX "_arm64[.]dll$")
+endif()
 # A stale unsuffixed payload would overwrite the selected architecture at
 # extraction time, so universal packages never embed it.
 list(FILTER CUSTOM_DLL_FILES EXCLUDE REGEX "[/\\\\]Toolscreen[.]dll$")
