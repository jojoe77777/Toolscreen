#include <winres.h>
VS_VERSION_INFO VERSIONINFO
 FILEVERSION @INSTALLER_VERSION_COMMAS@,0
 PRODUCTVERSION @INSTALLER_VERSION_COMMAS@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "jojoe77777\0"
            VALUE "FileDescription", "Toolscreen installer\0"
            VALUE "FileVersion", "@INSTALLER_VERSION@\0"
            VALUE "InternalName", "Toolscreen\0"
            VALUE "LegalCopyright", "Copyright (c) 2026 jojoe77777\0"
            VALUE "OriginalFilename", "Toolscreen-@INSTALLER_VERSION@-double-click-me.exe\0"
            VALUE "ProductName", "Toolscreen\0"
            VALUE "ProductVersion", "@INSTALLER_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
